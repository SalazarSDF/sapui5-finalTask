<mvc:View
    controllerName="sapui5finaltask.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="ODataDemo.Product"
                persistencyKey="SmartFilterPersistency"
                basicSearchFieldName="Name"
            >
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration
                        id="_IDGenControlConfiguration1"
                        key="Name"
                        visibleInAdvancedArea="true"
                    />
                </smartFilterBar:controlConfiguration>
            </smartFilterBar:SmartFilterBar>

            <smartTable:SmartTable
                id="smartTable"
                smartFilterId="smartFilterBar"
                tableType="ResponsiveTable"
                editable="false"
                entitySet="Products"
                enableExport="false"
                persistencyKey="SmartTablePersistency"
                enableAutoBinding="true"
                header="Products"
                initiallyVisibleFields="Name,Description,Price,Rating"
            >
                <smartTable:customToolbar>
                    <Toolbar id="_IDGenToolbar">
                        <ToolbarSpacer id="_IDGenToolbarSpacer" />
                        <Button
                            id="_IDGenButton"
                            text="Create"
                            press=".onCreate"
                            type="Emphasized"
                        />
                    </Toolbar>
                </smartTable:customToolbar>

                <Table
                    id="innerTable"
                    selectionChange=".onOpenObject"
                    mode="SingleSelectMaster"
                />
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
