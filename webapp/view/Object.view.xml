<mvc:View
    controllerName="sapui5finaltask.controller.Object"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    height="100%"
>
    <uxap:ObjectPageLayout id="objectPage">
        <uxap:headerTitle>
            <uxap:ObjectPageHeader
                objectTitle="{Name}"
                objectSubtitle="{Description}"
            >
                <uxap:actions>
                    <Button
                        id="editButton"
                        text="Edit"
                        press=".onEdit"
                        visible="{= !${view>/editMode} }"
                        type="Emphasized"
                    />
                    <Button
                        id="deleteButton"
                        text="Delete"
                        press=".onDelete"
                        visible="{= !${view>/editMode} }"
                        type="Negative"
                    />
                    <Button
                        id="saveButton"
                        text="Save"
                        press=".onSave"
                        visible="{view>/editMode}"
                        type="Accept"
                    />
                    <Button
                        id="cancelButton"
                        text="Cancel"
                        press=".onCancel"
                        visible="{view>/editMode}"
                        type="Reject"
                    />
                </uxap:actions>
            </uxap:ObjectPageHeader>
        </uxap:headerTitle>
        <uxap:sections>
            <uxap:ObjectPageSection title="Details">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <layout:Grid
                                defaultSpan="XL4 L4 M6 S12"
                                class="sapUiSmallMargin"
                            >
                                <VBox>
                                    <Label text="Name" />
                                    <Input
                                        id="nameInput"
                                        placeholder="{i18n>productNamePlaceholder}"
                                        required="true"
                                        value="{Name}"
                                        editable="{view>/editMode}"
                                        liveChange=".simpleValidation"
                                    />
                                </VBox>
                                <VBox>
                                    <Label text="Description" />
                                    <Input
                                        id="descriptionInput"
                                        placeholder="{i18n>productDescriptionPlaceholder}"
                                        required="true"
                                        value="{Description}"
                                        editable="{view>/editMode}"
                                        liveChange=".simpleValidation"
                                    />
                                </VBox>
                                <VBox>
                                    <Label text="Release Date" />
                                    <DatePicker
                                        value="{ReleaseDate}"
                                        editable="{view>/editMode}"
                                    />
                                </VBox>
                                <VBox>
                                    <Label text="Discontinued Date" />
                                    <DatePicker
                                        value="{DiscontinuedDate}"
                                        editable="{view>/editMode}"
                                    />
                                </VBox>
                                <VBox>
                                    <Label text="Rating" />
                                    <StepInput
                                        value="{Rating}"
                                        editable="{view>/editMode}"
                                        min="1"
                                        max="5"
                                    />
                                </VBox>
                                <VBox>
                                    <Label text="Price" />
                                    <Input
                                        value="{Price}"
                                        editable="{view>/editMode}"
                                        type="Number"
                                        placeholder="{i18n>productPricePlaceholder}"
                                    />
                                </VBox>
                            </layout:Grid>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
